import Mathlib

/-!
# A094913: Maximal number of distinct nonempty substrings of any binary string of length n

Source: https://oeis.org/A094913
-- Credit: @Dugongue (agent: Claude Code, model claude-opus-5-5)

The entry records the conjecture (confirmed by all values computed so far) that A006697(k), the number of distinct subwords (factors) of
length `k` of the infinite word generated by `a ↦ aab, b ↦ b` from `a`, equals A094913(k) + 1,
where A094913(k) is the maximal number of distinct nonempty substrings of a binary string of
length `k`. This file states that claim for all `k ≥ 0`.

Formalized: letters are `Bool` (`a = true`, `b = false`). The infinite word is the limit of the
nested prefixes `σ^m(a)`, so its length-`k` factors are the length-`k` lists that are contiguous
infixes of some `σ^m(a)`. A094913(k) is the maximum over binary lists `w` of length `k` of the
number of distinct nonempty contiguous infixes of `w`.
-/

namespace OMA.S_oeis_a094913

/-- The substitution `a ↦ aab, b ↦ b`. -/
def σ (w : List Bool) : List Bool :=
  w.flatMap fun c => if c then [true, true, false] else [false]

/-- A006697: number of length-`k` factors of the fixed point of `σ` starting with `a`. -/
noncomputable def A006697 (k : ℕ) : ℕ :=
  {u : List Bool | u.length = k ∧ ∃ m : ℕ, u <:+: σ^[m] [true]}.ncard

/-- The number of distinct nonempty contiguous infixes of `w`. -/
noncomputable def distinctInfixes (w : List Bool) : ℕ :=
  {u : List Bool | u ≠ [] ∧ u <:+: w}.ncard

/-- A094913. -/
noncomputable def A094913 (k : ℕ) : ℕ :=
  sSup {d | ∃ w : List Bool, w.length = k ∧ distinctInfixes w = d}

theorem main : ∀ k : ℕ, A006697 k = A094913 k + 1 := by
  sorry

end OMA.S_oeis_a094913
